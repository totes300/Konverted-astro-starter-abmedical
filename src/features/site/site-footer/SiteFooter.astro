---
import SiteNavLink from "~/features/site/SiteNavLink.astro";
import type { SiteFooterQResult } from "~/sanity/types";
import { getDraftModeProps } from "../../../sanity/lib/draft-mode";
import { loadQuery } from "../../../sanity/lib/load-query";
import { SiteFooterQ } from "./query";

const { data: siteFooter } = await loadQuery<SiteFooterQResult>({ query: SiteFooterQ, ...getDraftModeProps(Astro) });

const links = [...(siteFooter?.footer?.links ?? []), ...(siteFooter?.footer?.legalLinks ?? [])];
const year = new Date().getFullYear();
---

{
  siteFooter?.footer?.links && (
    <footer data-page-out="fade" data-page-in="fade">
      <div class="mx-auto flex max-w-(--page-width) flex-col gap-16 px-(--page-gutter) py-48 lg:flex-row lg:items-center lg:justify-between">
        <p class="text-body-10">
          © {year} {siteFooter.name}
        </p>
        <nav>
          <ul class="flex gap-24">
            {links.map((link, i) => (
              <li>
                <SiteNavLink link={link} animationDelay={i * 0.1} viewport={{ margin: '0px' }} />
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </footer>
  )
}
