---
import { cx } from "~/features/style/utils";

// Button with its variants flattened to a class map.
// Renders an <a> when `href` is set, else a <button>.
type Props = {
  href?: string;
  target?: string;
  rel?: string;
  download?: string | boolean;
  type?: "button" | "submit" | "reset";
  disabled?: boolean;
  variant?: "primary" | "underline" | "arrow" | "glass";
  class?: string;
  /** Set it when the label the reader hears is not the label on screen, as on a multi-state submit button. */
  "aria-label"?: string;
  /** Behaviour hooks a caller needs on the rendered element itself, e.g. the submit button's state. */
  [key: `data-${string}`]: string | undefined;
};

const {
  href,
  target,
  rel,
  download,
  type = "button",
  disabled,
  variant = "primary",
  class: className,
  "aria-label": ariaLabel,
  ...data
} = Astro.props;

const base =
  "inline-flex w-fit min-w-0 shrink-0 cursor-pointer items-center justify-center gap-8 whitespace-nowrap " +
  "font-pixel-square text-cta uppercase transition-[colors_transform] duration-200 ease-out active:scale-[0.97] " +
  "motion-reduce:transition-none motion-reduce:active:scale-100 " +
  "disabled:pointer-events-none disabled:opacity-50 disabled:grayscale";

const variants = {
  primary: "h-44 rounded-4 bg-white px-24 text-black hover:bg-white/80",
  underline: "text-white underline underline-offset-4",
  arrow: "group gap-16 font-sans text-button text-white",
  glass:
    "gap-4 rounded-4 bg-black-01/25 py-12 pr-20 pl-16 font-sans text-button-sm text-white backdrop-blur-16 hover:bg-black-01/40",
};

// tailwind-merge so caller classes reliably beat the defaults (e.g. a custom height or color).
const classes = cx(base, variants[variant], className);
const leadingArrow = variant === "glass";
const arrowTile = variant === "arrow";
---

{
  href ? (
    <a href={href} target={target} rel={rel} download={download} class={classes} aria-label={ariaLabel} {...data}>
      <slot name="left-icon" />
      {leadingArrow && <span aria-hidden="true">→</span>}
      <slot />
      {arrowTile && (
        <span
          aria-hidden="true"
          class="inline-flex size-32 items-center justify-center rounded-4 bg-white text-navy-blue transition-transform duration-200 ease-out group-hover:translate-x-4 motion-reduce:transition-none"
        >
          →
        </span>
      )}
      <slot name="right-icon" />
    </a>
  ) : (
    <button type={type} disabled={disabled} class={classes} aria-label={ariaLabel} {...data}>
      <slot name="left-icon" />
      {leadingArrow && <span aria-hidden="true">→</span>}
      <slot />
      {arrowTile && (
        <span
          aria-hidden="true"
          class="inline-flex size-32 items-center justify-center rounded-4 bg-white text-navy-blue transition-transform duration-200 ease-out group-hover:translate-x-4 motion-reduce:transition-none"
        >
          →
        </span>
      )}
      <slot name="right-icon" />
    </button>
  )
}
